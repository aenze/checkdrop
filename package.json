{
  "name": "checkdrop",
  "version": "0.1.7",
  "private": true,
  "description": "Customer Data Reliability API for explainable email, phone, address and company validation.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "benchmark:address": "pnpm --filter @checkdrop/db benchmark:address",
    "benchmark:address-normalization": "tsx benchmarks/address-normalization.ts",
    "benchmark:assistance-latency": "tsx benchmarks/assistance-latency.mts",
    "benchmark:validation": "tsx benchmarks/validation-corpus.ts",
    "build": "turbo run build",
    "check": "biome check .",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cli": "pnpm --filter @checkdrop/server cli",
    "dev": "turbo run dev --parallel",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "api-key:create": "pnpm --filter @checkdrop/server api-key:create",
    "ruian:import": "pnpm --filter @checkdrop/db import:ruian",
    "ruian:update": "pnpm --filter @checkdrop/db update:ruian",
    "spec:generate": "pnpm --filter @checkdrop/contracts build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
