---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import SiteAnalytics from "../../components/SiteAnalytics.astro";
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import InquiryForm from "../../components/InquiryForm.astro";
// Open-source repository. Change only here; the pricing card links to it.
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const GITHUB_URL = "https://github.com/aenze/checkdrop";
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const logo = `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="13" stroke="#3d7bff" stroke-width="2.6"/><path d="M10 16.5l4 4 8-9" stroke="#3d7bff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const iconMail = `<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 6l7 5 7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const iconPhone = `<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6.5 3.5h2.2l1.2 3.2-1.6 1.1a8.5 8.5 0 0 0 3.9 3.9l1.1-1.6 3.2 1.2v2.2c0 .8-.7 1.5-1.5 1.5A11.5 11.5 0 0 1 5 5c0-.8.7-1.5 1.5-1.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const iconPin = `<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 17.5s5.5-4.7 5.5-9a5.5 5.5 0 1 0-11 0c0 4.3 5.5 9 5.5 9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="10" cy="8.5" r="2" stroke="currentColor" stroke-width="1.6"/></svg>`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const iconId = `<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/><circle cx="7.5" cy="10" r="1.8" stroke="currentColor" stroke-width="1.5"/><path d="M11 8.5h4M11 11.5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const iconUser = `<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="7" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M4 16.5c.8-2.8 3.1-4 6-4s5.2 1.2 6 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const iconCheck = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 8.3l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const iconGithub = `<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>`;
---
<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Checkdrop opraví překlep v e-mailu, doplní adresu z registru a sjednotí telefon přímo ve formuláři: v košíku, poptávce, přihlášce i registraci.">
<title>Checkdrop — zachyťte překlep dřív, než se z něj stane vrácený balík</title>
<link rel="canonical" href="https://checkdrop.dev/cs/">
<link rel="alternate" hreflang="cs" href="https://checkdrop.dev/cs/">
<link rel="alternate" hreflang="en" href="https://checkdrop.dev/">
<link rel="alternate" hreflang="x-default" href="https://checkdrop.dev/">
<meta property="og:type" content="website">
<meta property="og:locale" content="cs_CZ">
<meta property="og:url" content="https://checkdrop.dev/cs/">
<meta property="og:title" content="Checkdrop — zachyťte překlep dřív, než se z něj stane vrácený balík">
<meta property="og:description" content="Kontrola e-mailu, telefonu, adresy a IČO přímo ve formuláři proti českým registrům. Open source.">
<meta property="og:site_name" content="Checkdrop">
<meta property="og:image" content="https://checkdrop.dev/frontpage/assets/og-cs-20261117.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Checkdrop opraví překlep v e-mailu přímo ve formuláři: jan.novak@gmial.com na jan.novak@gmail.com.">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' fill='none'%3E%3Ccircle cx='16' cy='16' r='13' stroke='%233d7bff' stroke-width='2.6'/%3E%3Cpath d='M10 16.5l4 4 8-9' stroke='%233d7bff' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<link rel="stylesheet" href="/frontpage/novy.css?v=20261117-3">
<SiteAnalytics />
</head>
<body>
<a class="skip" href="#main">Přejít na obsah</a>
<header class="nav">
  <div class="wrap">
    <a class="brand" href="/cs/"><Fragment set:html={logo} />Checkdrop</a>
    <nav aria-label="Hlavní navigace">
      <a href="#zachyti">Produkt</a>
      <a href="#cesty">Ceny</a>
      <a href="/cs/vyvojari/">Pro vývojáře</a>
      <a class="nav-login" href="https://app.checkdrop.dev/integrations">Přihlášení klientů</a>
      <a class="btn btn-blue btn-sm" href="#poptavka"><span class="full">Chci Checkdrop</span><span class="short">Poptávka</span></a>
      <div class="lang-switch" aria-label="Language / Jazyk"><a href="/" lang="en" hreflang="en">EN</a><a href="/cs/" class="on" aria-current="page" lang="cs" hreflang="cs">CS</a></div>
    </nav>
  </div>
</header>

<main id="main">
<section class="hero wrap">
  <div>
    <h1>Zachyťte překlep dřív, než se z něj stane vrácený balík.</h1>
    <p class="lead">Checkdrop kontroluje e-maily, telefony, adresy a IČO přímo ve formuláři, ať je to košík, poptávka, přihláška nebo registrace. Ověřuje je proti oficiálním českým registrům. Zákazník opravu potvrdí jedním kliknutím. Pokud chcete, zastaví i objednávku, kterou by nešlo doručit.</p>
    <div class="actions">
      <a class="btn btn-blue" href="#poptavka">Chci Checkdrop</a>
      <a class="btn btn-ghost" href="#ukazka">Vyzkoušet ukázku</a>
    </div>
    <ul class="proof">
      <li><Fragment set:html={iconCheck} />Adresy z registru RÚIAN</li>
      <li><Fragment set:html={iconCheck} />Firmy z ARES</li>
      <li><Fragment set:html={iconCheck} />Blokuje, jen když to zapnete</li>
    </ul>
  </div>

  <div id="ukazka">
    <div class="review" aria-label="Ukázka kontroly košíku">
      <div class="review-head">
        <strong>Doručovací údaje</strong>
        <div class="steps" aria-hidden="true"><span>1</span><i></i><span class="on">2</span><i></i><span>3</span></div>
        <span id="f-count">2 návrhy k potvrzení</span>
      </div>
      <div class="review-body">
        <div class="frow is-suggest" id="row-email">
          <span class="ficon"><Fragment set:html={iconMail} /></span>
          <div class="fbody">
            <div class="flabel"><label for="f-email">E-mail</label><span class="fstatus">Překlep v doméně</span></div>
            <input id="f-email" type="text" value="jan.novak@gmil.com" autocomplete="off" spellcheck="false">
            <div class="suggest" id="s-email"><span class="arrow">→</span><span class="val" id="s-email-val">jan.novak@gmail.com</span><span class="src">Doména</span><button type="button" class="use" id="s-email-use">Použít</button><button type="button" class="keep" id="s-email-keep">Ponechat</button></div>
          </div>
        </div>
        <div class="frow" id="row-phone">
          <span class="ficon"><Fragment set:html={iconPhone} /></span>
          <div class="fbody">
            <div class="flabel"><label for="f-phone">Telefon</label><span class="fstatus">Sjednotí se automaticky</span></div>
            <input id="f-phone" type="text" value="777123456" autocomplete="off">
          </div>
        </div>
        <div class="frow is-suggest" id="row-addr">
          <span class="ficon"><Fragment set:html={iconPin} /></span>
          <div class="fbody">
            <div class="flabel"><label for="f-street">Adresa</label><span class="fstatus">Neúplná adresa</span></div>
            <input id="f-street" type="text" value="Karlovo nám 19" autocomplete="off" spellcheck="false" aria-label="Ulice a číslo">
            <div class="fgrid">
              <input id="f-city" type="text" value="Praha" autocomplete="off" aria-label="Město">
              <input id="f-zip" type="text" value="" placeholder="PSČ" autocomplete="off" aria-label="PSČ">
            </div>
            <div class="suggest" id="s-addr" style="flex-direction:column;align-items:stretch;gap:6px;margin-top:2px">
              <span style="font-size:12px;color:var(--dim)">Vyberte adresní místo · zdroj RÚIAN</span>
              <div class="addr-opts" id="s-addr-list"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="review-foot">
        <div><strong>Zákazník potvrzuje, vy nic neřešíte.</strong>Opravu provedeme jen s jeho souhlasem. Sami sjednotíme jen formát telefonu.</div>
        <button type="button" class="btn btn-blue btn-sm" id="f-reset">Pokračovat k platbě</button>
      </div>
    </div>
    <p class="demo-note">Pište do polí. Ukázka posílá zadaný e-mail, telefon a adresu ke kontrole a nic z nich neukládá.</p>
  </div>
</section>

<section class="stats wrap" aria-label="Fakta">
  <div><strong>3</strong><span>zdroje: registry RÚIAN a ARES, kontrola domény e-mailu</span></div>
  <div><strong>3 mil.</strong><span>adresních míst v lokální kopii RÚIAN, obnova každý měsíc</span></div>
  <div><strong>0</strong><span>zastavených košíků, když Checkdrop neodpoví</span></div>
  <div><strong>90 dní</strong><span>uchování hodnot v monitoru, šifrovaně</span></div>
</section>

<section class="section video" id="video">
  <div class="wrap">
    <div class="section-head">
      <h2>Sedmnáct sekund od překlepu k čisté objednávce.</h2>
      <p>Zachycený překlep, doplněná adresa, sjednocený telefon. Pusťte si zvuk.</p>
    </div>
    <div class="video-frame">
      <video id="showreel" preload="metadata" playsinline poster="/frontpage/assets/showreel-poster-20260926.webp" width="1920" height="1080" aria-label="Video ukázka Checkdropu">
        <source src="/frontpage/assets/showreel-20260926.mp4" type="video/mp4">
      </video>
      <button type="button" class="video-play" id="showreel-play" aria-label="Přehrát"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor"/></svg><span>Přehrát</span></button>
    </div>
    <p class="video-note">Klip je v angličtině. Vše, co v něm vidíte, dnes běží ve skutečném košíku.</p>
  </div>
</section>

<section class="section" id="zachyti">
  <div class="wrap">
    <div class="section-head">
      <h2>Taková data v systému nechcete.</h2>
      <p>Najeďte na kartu a sledujte, jak Checkdrop z chyby udělá čistou objednávku.</p>
    </div>
    <div class="fixes">
      <article class="fix" tabindex="0">
        <div class="fix-top"><span class="ficon"><Fragment set:html={iconMail} /></span>E-mail<span class="fix-state"><span class="st-bad">Jak to zákazník napsal</span><span class="st-ok">Opraveno</span></span></div>
        <div class="fix-val"><div class="was">jan.novak@gmil.com</div><div class="now">jan.novak@gmail.com</div></div>
        <p class="why">Potvrzení objednávky a sledování zásilky dorazí. Zákazník nevolá, kde má balík.</p>
      </article>
      <article class="fix" tabindex="0">
        <div class="fix-top"><span class="ficon"><Fragment set:html={iconPin} /></span>Adresa<span class="fix-state"><span class="st-bad">Jak to zákazník napsal</span><span class="st-ok">Opraveno</span></span></div>
        <div class="fix-val"><div class="was">Karlovo nám 19, Praha</div><div class="now">Karlovo náměstí 19/13, 120 00 Praha 2</div></div>
        <p class="why">Kurýr najde dům napoprvé. Žádná vratka, žádné dohledávání po telefonu.</p>
      </article>
      <article class="fix" tabindex="0">
        <div class="fix-top"><span class="ficon"><Fragment set:html={iconPhone} /></span>Telefon<span class="fix-state"><span class="st-bad">Jak to zákazník napsal</span><span class="st-ok">Opraveno</span></span></div>
        <div class="fix-val"><div class="was">777123456</div><div class="now">+420 777 123 456</div></div>
        <p class="why">Kurýr se dovolá. Sklad i SMS brána dostanou jednotný formát.</p>
      </article>
      <article class="fix" tabindex="0">
        <div class="fix-top"><span class="ficon"><Fragment set:html={iconId} /></span>IČO<span class="fix-state"><span class="st-bad">Jak to zákazník napsal</span><span class="st-ok">Opraveno</span></span></div>
        <div class="fix-val"><div class="was">2708244</div><div class="now">27082440 · ověřeno v ARES</div></div>
        <p class="why">Faktura má správné údaje firmy hned. Účetní nic neopravuje zpětně.</p>
      </article>
      <article class="fix" tabindex="0">
        <div class="fix-top"><span class="ficon"><Fragment set:html={iconUser} /></span>Jméno<span class="fix-state"><span class="st-bad">Jak to zákazník napsal</span><span class="st-ok">Opraveno</span></span></div>
        <div class="fix-val"><div class="was">MUDr.Michal POřický</div><div class="now">MUDr. Michal Pořický</div></div>
        <p class="why">Oslovení v e-mailu a na štítku vypadá slušně, ne jako spam.</p>
      </article>
      <article class="fix" tabindex="0">
        <div class="fix-top"><span class="ficon"><Fragment set:html={iconPin} /></span>PSČ<span class="fix-state"><span class="st-bad">Jak to zákazník napsal</span><span class="st-ok">Opraveno</span></span></div>
        <div class="fix-val"><div class="was">Praha 2, 11000</div><div class="now">120 00 Praha 2</div></div>
        <p class="why">Zásilka jede rovnou na správné depo, ne oklikou přes špatné třídicí centrum.</p>
      </article>
    </div>
  </div>
</section>

<section class="section product" id="produkt">
  <div class="wrap">
    <div class="section-head">
      <h2>Každou opravu vidíte. Zapínáte jen to, co funguje.</h2>
      <p>Checkdrop nejdřív jen měří. V administraci vidíte, co zákazník napsal, co jsme navrhli a jak reagoval.</p>
    </div>
    <div class="frame">
      <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>app.checkdrop.dev/monitor</span></div>
      <picture>
        <source media="(max-width: 640px)" srcset="/frontpage/assets/monitor-mobile-20260908.webp" width="390" height="844">
        <img src="/frontpage/assets/monitor-light-20260908.webp" width="1440" height="900" loading="lazy" alt="Monitor Checkdropu: seznam zákazníků s kontrolovanými poli, reakcemi a výsledky">
      </picture>
    </div>
    <ul class="product-points">
      <li><strong>Tichý start</strong>První týdny nic nemění. Jen ukazuje, co by opravil.</li>
      <li><strong>Pole po poli</strong>E-mail, telefon, adresu nebo IČO zapínáte samostatně.</li>
      <li><strong>Data pod zámkem</strong>Hodnoty jsou šifrované a po 90 dnech se mažou.</li>
    </ul>
  </div>
</section>

<section class="section" id="cesty">
  <div class="wrap">
    <div class="section-head">
      <h2>Dva způsoby, jak Checkdrop nasadit.</h2>
      <p>Vždy stejný Checkdrop s otevřeným kódem. Liší se jen tím, kdo ho nasadí a udržuje.</p>
    </div>
    <div class="ways">
      <article class="way is-main">
        <span class="pill">Nasadíme vám to</span>
        <h3>Uděláme to za vás.</h3>
        <p>Napojíme váš formulář nebo košík, nastavíme pole a Checkdrop nasadíme na váš server, nebo ho provozujeme u nás v EU. První týdny jen měří, opravy zapneme, až uvidíte výsledky.</p>
        <span class="price">od 9 900 Kč<small>jednorázově, bez DPH, podle složitosti napojení</small></span>
        <a class="btn btn-blue" href="#poptavka">Domluvit nasazení</a>
      </article>
      <article class="way">
        <span class="pill pill-muted">Open source</span>
        <h3>Provozujete si to sami.</h3>
        <p>Celý Checkdrop je open source. Spustíte ho na vlastním serveru, zdarma. Až nebudete chtít, převezmeme to my.</p>
        <ul class="way-list">
          <li><Fragment set:html={iconCheck} />Dáte svému AI agentovi jeden odkaz. Na vašem serveru vše nainstaluje a ověří sám.</li>
          <li><Fragment set:html={iconCheck} />Sám se aktualizuje. Když něco selže, vrátí předchozí verzi.</li>
          <li><Fragment set:html={iconCheck} />Administrace česky i anglicky.</li>
        </ul>
        <span class="price">Zdarma<small>otevřený kód</small></span>
        <div class="way-actions">
          <a class="btn btn-ghost" href={GITHUB_URL}><Fragment set:html={iconGithub} />Kód na GitHubu</a>
          <a class="way-link" href="/cs/vyvojari/#vlastni-server">Pro vývojáře</a>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="cta" id="poptavka">
  <div class="wrap">
    <h2>Pošlete odkaz na svůj formulář.</h2>
    <p>Do dvou pracovních dnů napíšeme, co by Checkdrop zachytil a jak by nasazení vypadalo. Nezávazně.</p>
    <InquiryForm lang="cs" />
    <small>Neposílejte zákaznická data ani hesla. Nebo napište na <a href="mailto:support@checkdrop.dev">support@checkdrop.dev</a>.</small>
  </div>
</section>
</main>

<footer class="foot">
  <div class="wrap">
    <span>© 2026 ECOZZ s.r.o., Kladno · IČO 28371003 · projekt Aenze</span>
    <nav aria-label="Patička"><a href="/kontakt/">Kontakt</a><a href="/podminky/">Podmínky</a><a href="/soukromi/">Ochrana údajů</a><a href="/zpracovani/">Zpracování dat</a><a href="/" hreflang="en">English</a></nav>
  </div>
</footer>
<script is:inline src="/frontpage/novy.js?v=20261112-1"></script>
</body>
</html>
