---
// Open-source repository. Change only here; every link on this page derives from it.
const GITHUB_URL = "https://github.com/aenze/checkdrop";
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const INSTALL_URL = `${GITHUB_URL}/blob/main/INSTALL.md`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const iconGithub = `<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>`;
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const logo = `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="13" stroke="#3d7bff" stroke-width="2.6"/><path d="M10 16.5l4 4 8-9" stroke="#3d7bff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>For developers — Checkdrop</title>
<link rel="alternate" hreflang="cs" href="https://checkdrop.dev/cs/vyvojari/">
<link rel="stylesheet" href="/frontpage/novy.css?v=20261112-1">
<style>
  .dev { padding: 80px 0 40px; max-width: 760px; }
  .dev h1 { font-size: clamp(36px, 4vw, 56px); line-height: 1.04; }
  .dev .lead { margin-top: 20px; font-size: 18px; color: var(--muted); }
  .code { margin: 28px 0 0; font: 14px / 1.7 ui-monospace, "SF Mono", Menlo, monospace; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 20px 22px; white-space: pre; overflow-x: auto; color: var(--text); }
  .code .c { color: var(--dim); }
  .code .s { color: #8fb3ff; }
  .blk { padding: 56px 0; border-top: 1px solid var(--line); max-width: 760px; }
  .blk h2 { font-size: 30px; line-height: 1.1; }
  .blk p { margin-top: 14px; color: var(--muted); }
  .ep { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 12px 20px; margin-top: 24px; font-size: 14px; }
  .ep code { font: 13px ui-monospace, Menlo, monospace; color: var(--text); }
  .ep span { color: var(--muted); }
  .install { margin-top: 28px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; }
  .install-label { display: block; font-size: 13px; font-weight: 600; color: var(--muted); }
  .install-row { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
  .install-row code { flex-grow: 1; min-width: 0; font: 14px / 1.5 ui-monospace, "SF Mono", Menlo, monospace; color: var(--text); overflow-wrap: anywhere; }
  .install-row .btn { flex-shrink: 0; min-width: 96px; }
  .blk .install p { margin-top: 12px; font-size: 14px; }
  .spec { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 14px 20px; margin: 28px 0 0; font-size: 15px; }
  .spec dt { font-weight: 600; }
  .spec dd { margin: 0; color: var(--muted); }
  .dev-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .blk p.aside { margin-top: 20px; font-size: 14px; color: var(--dim); }
  .blk p.aside a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-2); }
  .blk p.aside a:hover { text-decoration-color: var(--text); }
  @media (max-width: 640px) { .ep, .spec { grid-template-columns: 1fr; gap: 4px 0; } .ep span, .spec dd { margin-bottom: 10px; } .install-row { flex-direction: column; align-items: stretch; } .dev-actions .btn { width: 100%; } }
</style>
</head>
<body>
<header class="nav">
  <div class="wrap">
    <a class="brand" href="/"><Fragment set:html={logo} />Checkdrop</a>
    <nav aria-label="Main navigation">
      <a href="/#catches">Product</a>
      <a href="/#pricing">Pricing</a>
      <a href="/developers/" style="color:var(--text)">Developers</a>
      <a class="nav-login" href="https://app.checkdrop.dev/integrations">Log in</a>
      <a class="btn btn-blue btn-sm" href="/#contact"><span class="full">Try it on your checkout</span><span class="short">Try it</span></a>
      <div class="lang-switch" aria-label="Language / Jazyk"><a href="/developers/" class="on" aria-current="page" lang="en" hreflang="en">EN</a><a href="/cs/vyvojari/" lang="cs" hreflang="cs">CS</a></div>
    </nav>
  </div>
</header>

<main class="wrap">
  <section class="dev">
    <h1>One line in your checkout.</h1>
    <p class="lead">The script finds the fields in your form and starts in silent mode. It changes nothing until you switch a field on in the admin.</p>
    <pre class="code">&lt;script src=<span class="s">"https://api.checkdrop.dev/v1/embed.js"</span> data-site=<span class="s">"pub_…"</span> defer&gt;&lt;/script&gt;</pre>
  </section>

  <section class="blk">
    <h2>Or the API.</h2>
    <p>Every response carries a state, a proposal and a source. When we're not sure we return <code>unknown</code> and the form goes through. The key belongs on your server, never in the browser.</p>
    <pre class="code">POST /v1/addresses/validate
&#123; "country": "CZ", "line": "Karlovo nám 19 Praha" &#125;

<span class="c">→ 200</span>
&#123; "state": <span class="s">"suggest"</span>,
  "proposal": <span class="s">"Karlovo náměstí 19/13, 120 00 Praha 2"</span>,
  "source": <span class="s">"ruian"</span> &#125;</pre>
    <div class="ep">
      <code>POST /v1/emails/validate</code><span>Format, domain typo, DNS and MX with a hard timeout</span>
      <code>POST /v1/phones/validate</code><span>Czech number and normalized format</span>
      <code>POST /v1/addresses/validate</code><span>Address completeness and a match in the RÚIAN registry</span>
      <code>POST /v1/addresses/autocomplete</code><span>Suggestions from a local copy of the registry</span>
      <code>POST /v1/company-ids/validate</code><span>Company ID, checksum, verification in ARES</span>
      <code>POST /v1/names/validate</code><span>First name, surname, academic titles</span>
    </div>
  </section>

  <section class="blk" id="self-hosting">
    <h2>Or the whole thing on your server.</h2>
    <p>Checkdrop is open source. Run it yourself with the same script and API as above, free.</p>
    <div class="install">
      <span class="install-label">Give your AI agent this link</span>
      <div class="install-row"><code id="install-url">{INSTALL_URL}</code><button type="button" class="btn btn-ghost btn-sm" data-copy="install-url" data-done="Copied">Copy</button></div>
      <p>Claude, ChatGPT or another agent that can work on your server installs Checkdrop and checks that everything runs. You only create the admin account with a one-time code.</p>
    </div>
    <dl class="spec">
      <dt>Server</dt><dd>One Linux server with Docker. A small VPS is enough: roughly 2&nbsp;CPU, 4&nbsp;GB RAM, 20&nbsp;GB disk.</dd>
      <dt>Updates</dt><dd>Automatic. Each installation checks for a new release, backs up, updates and rolls back if something fails. The admin shows the running version and what's new.</dd>
      <dt>Interface</dt><dd>English and Czech.</dd>
      <dt>Licences</dt><dd>Server and administration under AGPL-3.0. Validation core, country packs, the checkout script and plugins under MIT.</dd>
      <dt>Address data</dt><dd>Each installation downloads the RÚIAN registry straight from ČÚZK; we don't redistribute it. RÚIAN ©&nbsp;ČÚZK, CC&nbsp;BY&nbsp;4.0.</dd>
    </dl>
    <div class="dev-actions">
      <a class="btn btn-blue" href={GITHUB_URL}><Fragment set:html={iconGithub} />View on GitHub</a>
      <a class="btn btn-ghost" href={INSTALL_URL}>Install guide</a>
    </div>
    <p class="aside">Rather not run it yourself? We’ll deploy it and keep the data current, <a href="/#pricing">from CZK&nbsp;9,900</a>.</p>
  </section>
</main>

<footer class="foot">
  <div class="wrap">
    <span>© 2026 Aenze s.r.o., Kladno, Czech Republic · Company ID 28534395</span>
    <nav aria-label="Footer"><a href="/kontakt/" hreflang="cs">Contact</a><a href="/podminky/" hreflang="cs">Terms</a><a href="/soukromi/" hreflang="cs">Privacy</a><a href="/zpracovani/" hreflang="cs">Data processing</a><a href="/cs/vyvojari/" hreflang="cs">Česky</a></nav>
  </div>
</footer>
<script is:inline>
  for (const button of document.querySelectorAll("[data-copy]")) {
    button.addEventListener("click", async () => {
      const text = document.getElementById(button.dataset.copy)?.textContent ?? "";
      const label = button.textContent;
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = button.dataset.done;
        setTimeout(() => { button.textContent = label; }, 1600);
      } catch {
        getSelection()?.selectAllChildren(document.getElementById(button.dataset.copy));
      }
    });
  }
</script>
</body>
</html>
